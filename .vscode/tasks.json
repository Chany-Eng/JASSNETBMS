{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "probe-php-version",
			"type": "shell",
			"command": "php",
			"args": [
				"-v"
			],
			"isBackground": false
		},
		{
			"label": "probe-db-users",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysql.exe",
			"args": [
				"-u",
				"root",
				"-D",
				"jassnet_bms",
				"-e",
				"SELECT id, username, role, full_name, phone, email FROM users ORDER BY id LIMIT 10;"
			],
			"isBackground": false
		},
		{
			"label": "probe-mysql-ping",
			"type": "shell",
			"command": "C:\\xampp\\mysql\\bin\\mysqladmin.exe",
